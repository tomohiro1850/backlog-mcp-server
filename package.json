{
  "name": "@tmhr1850/backlog-mcp-server",
  "version": "1.0.2",
  "description": "Backlog APIへのアクセスを提供するMCPサーバー",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "backlog-mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
